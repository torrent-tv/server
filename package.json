    "guessit-js": "4.8.0",
    "hls.js": "^1.6.0",
    "media-chrome": "^4.19.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "knip": "^6.32.0"
